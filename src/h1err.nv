// h1err.nv — every way an HTTP/1.1 message can refuse to be read, and
// WHERE.
//
// Every body here is a `todo()`; the signatures are the design.
//
// WHY EVERY VARIANT CARRIES A BYTE OFFSET
//
// A malformed HTTP message is nearly always somebody else's: a proxy
// that folded a header, a client library that wrote a length it then
// did not honour, a script that sent CR without LF.  The only thing
// that makes such a report actionable is the byte the parser stopped
// at, because that is what a person pastes into `xxd -s` or a capture
// tool's offset box.  A parser that returns a reason and makes the
// caller carry the cursor gets a caller that does not carry the cursor,
// so `at` is in the variant rather than beside it.
//
// `at` is counted from the FIRST BYTE THE READER WAS EVER GIVEN, not
// from the start of the chunk that happened to contain the fault.  A
// chunk boundary is an artefact of how the host read its socket and it
// must not show up in an error a person reads; `h1read.offset` is the
// same counter, so a caller can print "byte 4,812 of this connection"
// without keeping a count of its own.
//
// DECODING AND ENCODING ARE TWO QUESTIONS, SO THEY ARE TWO TYPES
//
// `H1DecodeError` is "the peer sent something HTTP/1.1 does not allow".
// `H1EncodeError` is "you asked me to write something HTTP/1.1 does not
// allow" — a body on a 204, a Content-Length beside a
// Transfer-Encoding, a header value with a newline in it.  They are
// different types because they have different audiences: the first is a
// log line and possibly a 400, the second is a bug in the program that
// called this package, and a caller that had to `match` one enum for
// both would be writing arms it can never reach.
//
// Neither of them means "wait for more bytes".  That is
// `h1read.H1Step` with `event: None`, which is not an error at all —
// the same distinction `hci-codec-nv` draws between `Scan` and
// `DecodeError`, for the same reason.

// H1DecodeError is why a byte stream is not a well-formed HTTP/1.1
// message, and at which byte the reader gave up.
//
// The names are RFC 9112's subject matter rather than a parser's
// internal states, so a caller can map them onto the status code it
// wants to answer with: everything here except `MessageTruncated` and
// `BodyNotAllowed` is a 400, `HeadTooLarge` is a 431, and
// `MessageTruncated` has no answer because the connection is already
// gone.
//
// ```novo
// use h1err
//
// fn report(e: H1DecodeError) -> Str
//     "byte ${h1err.offset_of(e)}: ${e.message()}"
// ```
pub enum H1DecodeError
    // The first line is neither `method SP target SP version` nor
    // `version SP status SP reason` (RFC 9112 § 3, § 4).
    BadStartLine(at: Int)
    // A method token with a character outside `tchar` in it.  HTTP
    // methods are case-SENSITIVE, so a lowercase `get` is this and not
    // a `Get` — the refusal is deliberate, because a server that
    // accepted it would disagree with every other server about what
    // the request was.
    BadMethodToken(at: Int)
    // A request target that is none of RFC 9112 § 3.2's four forms.
    BadTargetForm(at: Int)
    // A version that is not `HTTP/1.0` or `HTTP/1.1`.  `HTTP/2` and
    // `HTTP/3` arrive as this too: they are not this package's wire
    // format, and pretending to parse one would be worse than refusing.
    BadHttpVersion(at: Int)
    // A status that is not three ASCII digits in `100 ..= 599`.
    BadStatusCode(at: Int)
    // A header name with a character outside `tchar`, or an empty one.
    // Also what obs-fold — a continuation line beginning with a space,
    // deprecated by RFC 9112 § 5.2 — arrives as, because the folded
    // line's first token is not a name.
    BadHeaderName(at: Int)
    // A header value containing a bare CR, a LF or a NUL.  This is the
    // response-splitting defence and it is not optional: a value that
    // can contain a newline is a value that can forge a second message.
    BadHeaderValue(at: Int)
    // The head — start line and headers together — passed
    // `H1Limits.max_head` before its terminating blank line.  Answer
    // 431.
    HeadTooLarge(at: Int, cap: Int)
    // More header fields than `H1Limits.max_headers` allows.
    TooManyHeaders(at: Int, cap: Int)
    // A `Content-Length` that is not a bare non-negative decimal, or a
    // repeated one whose copies disagree.  `text` is the value as it
    // stood, so the message can quote what was actually sent.
    BadContentLength(at: Int, text: Str)
    // `Content-Length` and `Transfer-Encoding` both present, or two
    // `Transfer-Encoding` values that disagree.  RFC 9112 § 6.1 says a
    // recipient MUST refuse: accepting one is the request-smuggling
    // bug, and it is a refusal rather than a preference for that
    // reason.
    ConflictingFraming(at: Int)
    // A `Transfer-Encoding` naming a coding this package does not
    // apply.  Only `chunked` is framing; `gzip` and friends are content
    // codings a caller decompresses AFTER this package has framed the
    // message.
    UnsupportedTransferCoding(at: Int, coding: Str)
    // A chunk-size line that is not hexadecimal, or a chunk extension
    // this package cannot skip.
    BadChunkSize(at: Int)
    // A chunk longer than `H1Limits.max_chunk`.
    ChunkTooLarge(at: Int, cap: Int)
    // A chunk not followed by the CRLF RFC 9112 § 7.1 requires, or a
    // last-chunk not followed by its terminating CRLF.
    BadChunkTerminator(at: Int)
    // A trailer section that broke one of the header rules, or a
    // trailer field the RFC forbids in one (`Content-Length`,
    // `Transfer-Encoding`, `Host`).
    BadTrailer(at: Int, name: Str)
    // The peer closed while a message was still open.  Not a fault in
    // what arrived — what arrived was fine and there was not enough of
    // it — which is why it is the one variant a caller may reasonably
    // treat as an ordinary end of connection when the framing was
    // `UntilClose`.
    MessageTruncated(at: Int)
    // A response the caller must not have a body for arrived with one:
    // a 1xx, a 204, a 304, or any response to a HEAD.  See
    // `h1msg.status_forbids_body`, which is the same rule as a
    // predicate.
    BodyNotAllowed(at: Int, status: Int)
    // The reader was asked for the next message and the previous one is
    // still open.  A caller's sequencing bug rather than the peer's,
    // and named separately so it is not logged as a peer fault.
    MessageStillOpen(at: Int)

// message renders the refusal as one line of prose, for a caller that
// logs rather than branches.
//
// `Result<_, H1DecodeError>` requires it: SPEC § 3.4 admits a `Result`
// error type only if it implements `Error`.
impl Error for H1DecodeError
    fn message(self) -> Str
        todo("http-codec-nv.h1err.H1DecodeError.message")

// H1EncodeError is why a message this package was asked to write would
// not have been legal HTTP/1.1.
//
// Every one of these is the calling PROGRAM's fault rather than a
// peer's, which is why they are a separate type from `H1DecodeError`:
// the two are answered in different places and by different people.
pub enum H1EncodeError
    // A body was supplied for a response whose status forbids one.
    // `h1msg.status_forbids_body` is the same rule asked in advance.
    BodyForbiddenForStatus(status: Int)
    // A body was supplied for a response to a HEAD request.  Separate
    // from the status rule because the status is perfectly ordinary —
    // it is the request method that removes the body.
    BodyForbiddenForHead
    // The headers name both `Content-Length` and `Transfer-Encoding`,
    // so the message would have been ambiguous on the wire.
    FramingConflictToWrite
    // A header name that is not a `tchar` token.
    BadHeaderNameToWrite(name: Str)
    // A header value containing CR, LF or NUL.  Refused rather than
    // sanitised: a package that quietly stripped the newline would be
    // deciding, on the program's behalf, that a forged header is
    // acceptable if it is stripped.
    BadHeaderValueToWrite(name: Str)
    // A method token that is not a `tchar` token.
    BadMethodTokenToWrite(token: Str)
    // A status outside `100 ..= 599`.
    BadStatusCodeToWrite(status: Int)
    // A request with no `Host` header at `HTTP/1.1`, which RFC 9112
    // § 3.2 makes mandatory.
    MissingHost
    // A `Content-Length` that disagrees with the body actually handed
    // over.  `declared` is what the headers said, `actual` what arrived.
    LengthDisagreesWithBody(declared: Int, actual: Int)

// message renders the refusal as one line of prose.
impl Error for H1EncodeError
    fn message(self) -> Str
        todo("http-codec-nv.h1err.H1EncodeError.message")

// offset_of is the byte a decode refusal stopped at, counted from the
// first byte the reader was ever given.
//
// Every `H1DecodeError` variant has one, so this is total — there is no
// `-1` case and a caller never has to ask whether the number means
// anything.
pub fn offset_of(e: H1DecodeError) -> Int
    todo("http-codec-nv.h1err.offset_of")

// status_for is the response status a server should answer a refusal
// with, or `None` when there is nobody left to answer.
//
// 400 for a malformed message, 431 for `HeadTooLarge` and
// `TooManyHeaders`, 501 for `UnsupportedTransferCoding`, and `None` for
// `MessageTruncated` and `MessageStillOpen` — the first because the
// connection is gone, the second because the fault is the caller's own
// and answering the peer would be answering the wrong party.
pub fn status_for(e: H1DecodeError) -> ?Int
    todo("http-codec-nv.h1err.status_for")
