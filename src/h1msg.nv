// h1msg.nv — an HTTP/1.1 message as values, and the framing rules that
// decide how long its body is.
//
// Every body here is a `todo()`; the signatures are the design.
//
// WHY THE TYPES ARE NAMED `H1…`
//
// The standard library already owns `HttpRequest`, `HttpResponse` and
// `HttpHeader` — they are `std.http`'s client and server types — and a
// public type name is unique across a whole assembly, not per package
// (`docs/publishing.md` § Public type names are globally unique).  `H1`
// is what the reference implementations call this wire format when they
// have to distinguish it from HTTP/2 (h11, h2, `curl --http1.1`), so
// the prefix says something true rather than only avoiding a clash:
// these types are HTTP/1.1's, and an HTTP/2 codec would bring its own.
//
// WHAT A HEAD IS, AND WHAT IT IS NOT
//
// `H1Request` and `H1Response` are HEADS.  Neither carries a body, and
// that is the single most load-bearing decision in the package: a body
// arrives as a series of `BodyBytes` events over as long as the peer
// takes to send it, and a struct that had a `body: [u8]` field would
// have forced this package to buffer a whole upload before handing
// anything back.  A 4 GB PUT is a normal thing for a person to do and
// an embedded consumer has 64 KB of RAM; the head/body split is what
// lets both work.
//
// The framing is therefore a separate question with its own answer:
// `request_framing` and `response_framing` compute, from the head,
// exactly how many body bytes are due and how they are delimited.  It
// is a function rather than a field because it depends on things the
// head does not contain — the method of the request a response is
// answering, most importantly, since a response to HEAD has the
// Content-Length of the body it does not send.

// H1Version is the two HTTP versions this wire format has.
//
// `HTTP/0.9` is not here: it has no headers, no status line and no
// version token, so a parser for it is a different parser.  `HTTP/2`
// and `HTTP/3` are not here either — they are different wire formats
// that happen to share a semantics, and `h1err.BadHttpVersion` is what
// a reader answers when it meets one.
pub enum H1Version
    Http10
    Http11

// H1Method is a request method: the nine RFC-registered ones by name,
// and everything else as its token.
//
// `ExtensionMethod` is not a fallback for a typo.  WebDAV, CalDAV and
// every private API in the world register methods, RFC 9110 § 9 says
// the list is open, and a codec that refused what it did not recognise
// would be a codec you cannot proxy through.  What it does NOT do is
// case-fold: HTTP methods are case-sensitive, so `get` arrives as
// `ExtensionMethod("get")` if it is a legal token at all, and a server
// that wanted to accept it has to say so itself.
pub enum H1Method
    Get
    Head
    Post
    Put
    Delete
    Connect
    Options
    Trace
    Patch
    ExtensionMethod(token: Str)

// H1TargetForm is which of RFC 9112 § 3.2's four shapes a request
// target has.
//
// The form is not decoration: a server must refuse an authority-form
// target on anything but CONNECT and an asterisk-form on anything but
// OPTIONS, and a target that arrives in absolute-form overrides the
// `Host` header.  Those are three rules a caller gets wrong by not
// knowing which form it is holding, so this package answers the
// question rather than leaving it in prose.
pub enum H1TargetForm
    // `/where?q=now` — the ordinary one.
    OriginForm
    // `http://example.org/where` — a proxy request, and what a
    // conforming server must also accept directly.
    AbsoluteForm
    // `example.org:443` — CONNECT, and only CONNECT.
    AuthorityForm
    // `*` — a server-wide OPTIONS, and only OPTIONS.
    AsteriskForm

// H1Header is one header field, in the case it arrived in.
//
// The original case is kept for a reason that is easy to argue away and
// expensive to have argued away: a proxy that lower-cases what it
// forwards changes the bytes a signature was computed over, and an HTTP
// message signature (RFC 9421) covers the field name as written.  So
// lookup is case-insensitive (`get`) and storage is verbatim
// (`fields_of`), and the two are different operations rather than one
// operation with a lossy store behind it.
pub struct H1Header
    // The field name exactly as it was written or supplied.
    name: Str
    // The field value with leading and trailing optional whitespace
    // removed, which RFC 9112 § 5 says is not part of the value.
    value: Str

// H1Headers is a header section: the fields in order, with lookup by
// name that ignores case.
//
// A list and not a map, for the reason csv-nv's `Row` is a list: a map
// loses the order the peer sent, cannot hold the repeated fields that
// `Set-Cookie` and `Via` legitimately have, and costs a hash per field
// on a path whose whole job is to be cheap.  `get` searches; a section
// is a dozen fields and a search over a dozen strings is faster than
// building a table nobody asked for.
pub struct H1Headers
    // The fields, in the order they arrived.  Reaching into this
    // directly is what `fields_of` is for — the field is here because a
    // struct needs one, and its shape is a decision this package
    // intends to be free to change.
    fields: [H1Header]

// H1Request is a request head: what a request line and its header
// section said, and nothing about a body.
pub struct H1Request
    method: H1Method
    // The target exactly as it arrived, un-decoded.  `target_form`
    // classifies it and url-nv parses it; this package does neither,
    // because a percent-decode this package performed would be a
    // percent-decode a caller could not opt out of, and a target's
    // `%2F` is not a `/`.
    target: Str
    version: H1Version
    headers: H1Headers

// H1Response is a response head: what a status line and its header
// section said, and nothing about a body.
pub struct H1Response
    version: H1Version
    // The three-digit status, `100 ..= 599`.
    status: Int
    // The reason phrase as it arrived, which may be empty.  Kept
    // because it is what the peer wrote, and discarded by nobody but
    // the caller: RFC 9112 § 4 says a client MUST NOT act on it, and
    // that is a rule about acting rather than about storing.
    reason: Str
    headers: H1Headers

// H1Framing is how long a message's body is, and how you know.
//
// This is the answer to the only question that matters between two
// messages on one connection, and getting it wrong is the
// request-smuggling class of bug in one sentence.  It is computed from
// a head by `request_framing` and `response_framing` rather than stored
// on one, because the same head frames differently depending on what it
// is answering.
pub enum H1Framing
    // No body at all, and none is coming: a GET without a body, a 204,
    // a 304, any response to HEAD.
    NoBody
    // Exactly `len` bytes, from `Content-Length`.
    FixedLength(len: Int)
    // Chunked transfer coding — `len` is not known in advance and the
    // last chunk says when it ends (RFC 9112 § 7.1).
    ChunkedBody
    // Until the peer closes the connection.  A response only: a request
    // framed this way could never be answered, since the server would
    // have to close to know the request had ended.  It also implies the
    // connection cannot be reused, which `may_reuse` knows.
    UntilClose

// headers builds a header section from fields in the order given.
//
// ```novo
// use h1msg
//
// fn main() [io]
//     let h = h1msg.headers([
//         H1Header { name: "Host", value: "example.org" },
//         H1Header { name: "Accept", value: "*/*" }])
//     println("${h1msg.field_count(h)}")
// ```
pub fn headers(fields: [H1Header]) -> H1Headers
    todo("http-codec-nv.h1msg.headers")

// no_headers is an empty header section.
pub fn no_headers() -> H1Headers
    todo("http-codec-nv.h1msg.no_headers")

// name_eq compares two field names the way RFC 9110 § 5.1 says to:
// ASCII case-insensitively, and only ASCII.
//
// Only ASCII is the point.  A Unicode case fold would make the Turkish
// dotless `ı` equal to `I` and let one peer's `Content-Length` differ
// from another's, which is a security property and not a nicety.
pub fn name_eq(a: Str, b: Str) -> Bool
    todo("http-codec-nv.h1msg.name_eq")

// get is the first value of a named field, ignoring case, or `None`.
//
// First and not joined: a caller that needs every value of a repeated
// field asks `get_all`, and one that joins `Set-Cookie` values with
// commas has produced a cookie nobody can parse.
pub fn get(h: H1Headers, name: Str) -> ?Str
    todo("http-codec-nv.h1msg.get")

// get_all is every value of a named field, in the order they arrived.
pub fn get_all(h: H1Headers, name: Str) -> [Str]
    todo("http-codec-nv.h1msg.get_all")

// has says whether a named field is present at all.
pub fn has(h: H1Headers, name: Str) -> Bool
    todo("http-codec-nv.h1msg.has")

// set replaces every copy of a named field with one carrying this
// value, keeping the position the first copy had.
//
// Keeping the position matters for the same reason keeping the case
// does: a section whose fields move when one is edited is a section
// whose bytes change for no reason a reader of the diff can see.
pub fn set(h: H1Headers, name: Str, value: Str) -> H1Headers
    todo("http-codec-nv.h1msg.set")

// append adds a field after the existing ones without touching them.
//
// This is what `Set-Cookie` and `Via` need and what `set` must not do.
pub fn append(h: H1Headers, name: Str, value: Str) -> H1Headers
    todo("http-codec-nv.h1msg.append")

// remove drops every copy of a named field.
pub fn remove(h: H1Headers, name: Str) -> H1Headers
    todo("http-codec-nv.h1msg.remove")

// fields_of is every field, in order, in the case it arrived in.
pub fn fields_of(h: H1Headers) -> [H1Header]
    todo("http-codec-nv.h1msg.fields_of")

// field_count is how many fields the section holds, repeats included.
pub fn field_count(h: H1Headers) -> Int
    todo("http-codec-nv.h1msg.field_count")

// is_token says whether a string is a `tchar` token — a legal method,
// a legal field name, a legal transfer coding (RFC 9110 § 5.6.2).
//
// Public because a caller building a header from user input needs the
// same answer this package's encoder needs, and a caller that had to
// re-derive it would derive it differently.
pub fn is_token(s: Str) -> Bool
    todo("http-codec-nv.h1msg.is_token")

// is_field_value says whether a string may be a field value: no CR, no
// LF, no NUL, no leading or trailing space.
pub fn is_field_value(s: Str) -> Bool
    todo("http-codec-nv.h1msg.is_field_value")

// method_token is the method as it goes on the wire.
pub fn method_token(m: H1Method) -> Str
    todo("http-codec-nv.h1msg.method_token")

// method_of reads a method token, exactly and case-sensitively.
//
// Every token that is legal `tchar` gets an answer — one of the nine
// names, or `ExtensionMethod` — and a token that is not returns `None`.
pub fn method_of(token: Str) -> ?H1Method
    todo("http-codec-nv.h1msg.method_of")

// version_text is the version as it goes on the wire: `HTTP/1.1`.
pub fn version_text(v: H1Version) -> Str
    todo("http-codec-nv.h1msg.version_text")

// target_form classifies a request target, given the method it arrived
// with.
//
// The method is a parameter because two of the four forms are legal
// only with one method each, and `None` is the answer for a target that
// is no form at all — or is a form this method may not use.
//
// ```novo
// use h1msg
//
// fn main() [io]
//     match h1msg.target_form("/index.html", Get)
//         Some(OriginForm) => println("ordinary")
//         Some(_)          => println("unusual, but legal")
//         None             => println("not a request target")
// ```
pub fn target_form(target: Str, m: H1Method) -> ?H1TargetForm
    todo("http-codec-nv.h1msg.target_form")

// request_framing is how long this request's body is.
//
// The rules, in the order RFC 9112 § 6 applies them: a
// `Transfer-Encoding` ending in `chunked` frames the message; a
// `Content-Length` frames it at that many bytes; both present is
// `h1err.ConflictingFraming` and never a preference; neither means the
// request has no body at all.  A request is never `UntilClose`.
pub fn request_framing(req: H1Request) -> Result<H1Framing, H1DecodeError>
    todo("http-codec-nv.h1msg.request_framing")

// response_framing is how long this response's body is, given the
// method of the request it answers.
//
// THE METHOD ARGUMENT IS THE WHOLE POINT.  A response to HEAD carries
// the `Content-Length` of the body it is not sending, and a client that
// framed on that header alone waits forever for bytes that were never
// coming — which is the oldest bug in HTTP client code and the reason
// this signature will not let you not know the method.  The same
// applies to a 204 and a 304, which `status_forbids_body` covers, and
// to a 2xx answer to CONNECT, after which the connection stops being
// HTTP at all.
pub fn response_framing(sent: H1Method, resp: H1Response) -> Result<H1Framing, H1DecodeError>
    todo("http-codec-nv.h1msg.response_framing")

// status_forbids_body says whether a status code may never carry a
// body: every 1xx, 204 and 304.
//
// A PREDICATE AND NOT A PARAGRAPH.  This is one of the two rules a
// caller most reliably gets wrong, and prose in a README is not
// something a program can consult, so it is a function — and
// `h1write.response` calls it, which means a program that ignores it
// still cannot write the illegal message.
//
// ```novo
// use h1msg
//
// fn main() [io]
//     println("${h1msg.status_forbids_body(304)}")   // true
//     println("${h1msg.status_forbids_body(200)}")   // false
// ```
pub fn status_forbids_body(status: Int) -> Bool
    todo("http-codec-nv.h1msg.status_forbids_body")

// is_informational says whether a status is 1xx — a response a client
// must read and then keep reading past, because the real one follows.
pub fn is_informational(status: Int) -> Bool
    todo("http-codec-nv.h1msg.is_informational")

// status_reason is the reason phrase the IANA registry gives a status,
// or an empty string for one it does not name.
//
// For an encoder that wants to write something and a log that wants to
// print something.  A reader never needs it: what the peer sent is in
// `H1Response.reason`.
pub fn status_reason(status: Int) -> Str
    todo("http-codec-nv.h1msg.status_reason")

// may_reuse says whether this connection can carry another message
// after this exchange finished.
//
// THE SECOND RULE A CALLER MUST NOT GET WRONG, AND THE SECOND
// PREDICATE.  Persistence in HTTP/1.1 is four rules that interact:
// `Connection: close` from either party ends it; `HTTP/1.0` is not
// persistent unless it said `Connection: keep-alive`; a response framed
// `UntilClose` cannot be followed by anything, because the close IS the
// framing; and a 101 or a 2xx answer to CONNECT hands the connection to
// a different protocol entirely.  A client that reuses a connection it
// should not have gets its next request answered by the tail of the
// previous body, which is a data-disclosure bug rather than a hiccup.
//
// Both heads are parameters because two of the four rules live in the
// request and two in the response.
//
// ```novo
// use h1msg
//
// fn main() [io]
//     let req = H1Request {
//         method: Get, target: "/", version: Http11,
//         headers: h1msg.headers([H1Header { name: "Host", value: "e.org" }]) }
//     let resp = H1Response {
//         version: Http11, status: 200, reason: "OK",
//         headers: h1msg.headers([
//             H1Header { name: "Content-Length", value: "3" }]) }
//     println("${h1msg.may_reuse(req, resp)}")
// ```
pub fn may_reuse(req: H1Request, resp: H1Response) -> Bool
    todo("http-codec-nv.h1msg.may_reuse")

// wants_close says whether a header section asked for the connection to
// end, at this version.
//
// The half of `may_reuse` that one party can answer alone, exported
// because a server deciding what to put in its own `Connection` field
// needs it before it has a response to pass to `may_reuse`.
pub fn wants_close(v: H1Version, h: H1Headers) -> Bool
    todo("http-codec-nv.h1msg.wants_close")

// is_upgrade says whether this exchange left HTTP/1.1 behind: a 101
// answering an `Upgrade` request, or a 2xx answering a CONNECT.
//
// A caller that gets `true` must stop feeding bytes to this package —
// what follows on the connection is not HTTP/1.1 and this package would
// be reading it as if it were.  websocket-codec-nv is the first
// consumer of this answer.
pub fn is_upgrade(sent: H1Method, resp: H1Response) -> Bool
    todo("http-codec-nv.h1msg.is_upgrade")
