// tests/h1read_tests.nv — the reader's calls, one at a time.
//
// `test_drain_over_a_buffer_costs_nothing` is also checked by the
// compiler: it would not compile if `drain` declared an effect of its
// own instead of binding the source's.

use std.test
use std.bytes
use h1read
use h1msg
use h1err

// `GET / HTTP/1.1\r\nHost: e\r\n\r\n`, the smallest complete request
// there is: 27 bytes.
fn a_get_on_the_wire() -> [u8]
    bytes.to_byte_list(bytes.from_str("GET / HTTP/1.1\r\nHost: e\r\n\r\n"))

fn a_server_reader() -> H1Reader
    h1read.reader(ReadsRequests, h1read.default_limits())

@test
fn test_a_fresh_reader_holds_nothing_and_has_consumed_nothing() [io]
    test.case("a new reader")
    let r = a_server_reader()
    test.assert(h1read.pending_len(r) == 0)
    test.assert(h1read.offset(r) == 0)
    test.assert(not h1read.message_open(r))

@test
fn test_a_prefix_is_not_an_event_and_not_an_error() [io]
    // Waiting for more bytes is `event: None`, not an `H1DecodeError`.
    test.case("three bytes of a request line")
    match h1read.feed(a_server_reader(), ['G' as u8, 'E' as u8, 'T' as u8])
        Err(_)   => test.fail("an incomplete head is not malformed")
        Ok(step) =>
            match step.event
                None    => test.assert(true)
                Some(_) => test.fail("three bytes cannot complete a head")

@test
fn test_a_whole_request_comes_out_as_a_head_then_an_end() [io]
    test.case("the head")
    let first = h1read.feed(a_server_reader(), a_get_on_the_wire())!
    match first.event
        Some(RequestHead(req)) =>
            test.assert(h1msg.method_token(req.method) == "GET")
            test.assert(req.target == "/")
        Some(_)                => test.fail("a server's reader produces request heads")
        None                   => test.fail("that is a whole request")

    test.case("and the end, since a GET with no framing header has no body")
    let second = h1read.take(first.reader)!
    match second.event
        Some(MessageDone) => test.assert(true)
        Some(_)           => test.fail("nothing comes between the head and the end")
        None              => test.fail("the message ended with the head")

@test
fn test_one_feed_drains_one_event_and_take_gets_the_rest() [io]
    // A feed that completes two events answers one and keeps the other.
    test.case("feed then take")
    let step = h1read.feed(a_server_reader(), a_get_on_the_wire())!
    test.assert(h1read.message_open(step.reader))
    let next = h1read.take(step.reader)!
    match next.event
        Some(_) => test.assert(true)
        None    => test.fail("the end was still buffered")

@test
fn test_a_head_that_never_ends_is_refused_at_the_limit() [io]
    test.case("max_head")
    let tiny = H1Limits { max_head: 8, max_headers: 4, max_chunk: 64 }
    match h1read.feed(h1read.reader(ReadsRequests, tiny), a_get_on_the_wire())
        Ok(_)  => test.fail("27 bytes of head is past a cap of 8")
        Err(e) =>
            match e
                HeadTooLarge(_, cap) => test.assert(cap == 8)
                _                    => test.fail("the refusal names the cap")

@test
fn test_a_refusal_carries_the_byte_it_stopped_at() [io]
    test.case("offset_of is total")
    let e = BadStartLine(17)
    test.assert(h1err.offset_of(e) == 17)

    test.case("and a server knows what to answer")
    match h1err.status_for(BadStartLine(17))
        Some(s) => test.assert(s == 400)
        None    => test.fail("a malformed request gets a 400")
    match h1err.status_for(HeadTooLarge(9000, 8192))
        Some(s) => test.assert(s == 431)
        None    => test.fail("an oversized head gets a 431")
    match h1err.status_for(MessageTruncated(4))
        None    => test.assert(true)
        Some(_) => test.fail("there is nobody left to answer")

@test
fn test_a_reader_is_told_the_method_it_answers() [io]
    // `expect` answers a reader, so the queue of sent methods lives in
    // the reader and not in the caller.
    test.case("expect")
    let r = h1read.expect(h1read.reader(ReadsResponses, h1read.default_limits()), Head)
    test.assert(h1read.offset(r) == 0)

@test
fn test_a_close_between_messages_is_not_a_truncation() [io]
    test.case("finish on an idle reader")
    match h1read.finish(a_server_reader())
        Err(_)   => test.fail("closing between messages is ordinary")
        Ok(step) =>
            match step.event
                None    => test.assert(true)
                Some(_) => test.fail("nothing was in progress")

@test
fn test_a_close_inside_a_message_is_a_truncation() [io]
    test.case("finish mid-head")
    let step = h1read.feed(a_server_reader(), ['G' as u8, 'E' as u8, 'T' as u8])!
    match h1read.finish(step.reader)
        Ok(_)  => test.fail("half a request line is not a request")
        Err(e) =>
            match e
                MessageTruncated(_) => test.assert(true)
                _                   => test.fail("the refusal says what happened")

@test
fn test_parse_head_reads_a_head_a_caller_already_holds() [io]
    test.case("parse_head")
    match h1read.parse_head(a_get_on_the_wire(), ReadsRequests, h1read.default_limits())
        Err(_)   => test.fail("that is a well-formed head")
        Ok(step) =>
            match step.event
                None                 => test.fail("the head is complete")
                Some(RequestHead(_)) => test.assert(h1read.offset(step.reader) == 27)
                Some(_)              => test.fail("a request head")

@test
fn test_the_two_named_limit_sets_differ_by_orders_of_magnitude() [io]
    test.case("default_limits and embedded_limits")
    let big = h1read.default_limits()
    let small = h1read.embedded_limits()
    test.assert(small.max_head < big.max_head)
    test.assert(small.max_headers < big.max_headers)
    test.assert(small.max_chunk < big.max_chunk)

@test
fn test_drain_over_a_buffer_costs_nothing() [io]
    // `drain<S: Read[e]>` binds the effect parameter of the standard
    // library's `Read`, and `impl Read[] for Buffer` supplies none, so
    // this function's `[io]` is for the test calls alone.
    test.case("drain over an in-memory Buffer")
    let src = Buffer.from_str("GET / HTTP/1.1\r\nHost: e\r\n\r\n")
    match h1read.drain(a_server_reader(), src)
        Ok(d)  => test.assert(list.len(d.events) == 2)
        Err(_) => test.fail("a well-formed request")
    src.drop()

// A source whose stream fails on every call.
struct Failing
    code: Int

impl Read[] for Failing
    fn read(self, n: Int) -> Result<Bytes, IoError> []
        Err(IoNotFound)

// What a drain answered, as text: the event count or the refusal.
fn drained(r: Result<H1Drained, h1err.H1DecodeError>) -> Str
    match r
        Ok(d)  => "${list.len(d.events)} events"
        Err(e) => e.message()

@test
fn test_drain_reads_a_failing_source_as_the_end_of_the_stream() [io]
    test.case("a source that fails is a stream that ended")
    let empty = Buffer.from_str("")
    test.assert_eq(drained(h1read.drain(a_server_reader(), Failing { code: 0 })),
        drained(h1read.drain(a_server_reader(), empty)))
    empty.drop()
